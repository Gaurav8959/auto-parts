{
  "name": "auto-parts-server",
  "version": "1.0.0",
  "description": "Auto parts shop - inventory, stock and billing API",
  "main": "server/index.ts",
  "scripts": {
    "dev": "cross-env nodemon --watch server --ext ts --exec ts-node server/index.ts",
    "start": "ts-node server/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node server/seeds/index.ts",
    "migration:create": "typeorm migration:create",
    "migration:generate": "ts-node ./node_modules/typeorm/cli.js migration:generate -d ./server/data-source/data-source.ts",
    "migration:run": "ts-node ./node_modules/typeorm/cli.js migration:run -d ./server/data-source/data-source.ts",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d ./server/data-source/data-source.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit"
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.9",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-async-handler": "^1.2.0",
    "express-joi-validation": "^5.0.1",
    "express-rate-limit": "^8.7.1",
    "http-status-codes": "^1.4.0",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.5",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "pdfmake": "^0.2.23",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "@types/pdfmake": "^0.2.13",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
